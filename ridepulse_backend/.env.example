# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI (Free Tier M0)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/ridepulse_db?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=ridepulse_jwt_access_secret_key_change_in_production_32chars
JWT_REFRESH_SECRET=ridepulse_jwt_refresh_secret_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Client Security
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173,https://ridepulse.vercel.app

# Optional Cloudinary Storage (Free Tier)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=demo_secret
